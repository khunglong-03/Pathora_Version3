# ── ASP.NET Core ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ── Auth & Dev (CRITICAL: Must be false in production) ───────
Auth__DisableAuthorization=false
Dev__EnableDevEndpoints=false
Dev__DevApiKey=
Dev__ResetAndReseedOnStartup=false

# ── Serilog ──────────────────────────────────────────────────
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Mvc=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Routing=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore.Hosting=Warning
Serilog__MinimumLevel__Override__ZiggyCreatures.Caching.Fusion=Warning
Serilog__MinimumLevel__Override__System.Net.Http=Warning

# ── CORS (CRITICAL: Single domain for login to work) ─────────
